APP_NAME="Machine Predictive Maintenance Classification API"
VERSION="1.0"
HOST="0.0.0.0"
PORT=8000
LOG_LEVEL="INFO"
threshold=0.8966

# --- Monitoring dashboard simulation ---
# Path to the held-out test split used as the replay source (defaults to <project>/Data/test_set.csv)
# TEST_SET_PATH="Data/test_set.csv"
# Shuffle seed — same seed reproduces the same replay order
SIM_SEED=42
# Default number of machines per simulated batch
SIM_BATCH_SIZE=50
# Upper bound the API accepts for a single batch
SIM_BATCH_MAX=200
# Dashboard poll interval in milliseconds
DASHBOARD_POLL_MS=5000

